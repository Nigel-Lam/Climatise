{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 450,
  "title": "% Change in Victorian Median Salary per Job by Region (2020 to 2021)",

  "projection": {
    "type": "mercator",
    "center": [145.1938, -36.2004],
    "scale": 3750,
    "translate": [425, 190]
  },  
  
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Nigel-Lam/Climatise/refs/heads/main/geojson/SA3_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA3_2021_AUST_GDA2020"}
      },
      "transform":[
        {"filter": "datum.properties.STE_NAME21 === 'Victoria' "}
      ],
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"}
    },

    { 
      "data": {
        "url": "https://raw.githubusercontent.com/Nigel-Lam/Climatise/refs/heads/main/geojson/SA3_2021_AUST_GDA2020.json",
        "format": {"type": "topojson", "feature": "SA3_2021_AUST_GDA2020"}
      },
      "transform": [
        {
          "lookup": "properties.SA3_NAME21",
          "from": {
            "data": {
              "url": "https://friedchickenbigdrip.github.io/FIT3179-Week-9-Homework/data/VictMedianSalaryPerJob.csv"
            },
            "key": "SA3 NAME",
            "fields": ["2021-22"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "2021-22",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [-0.15, -0.10, -0.05, 0],
            "range": ["#d73027", "#fc8d59", "#fdae61", "#fee08b", "#d9ef8b"]
          },
          "title": "% Change in Median Salary",
          "format": ".2%"
        },
        "tooltip": [
          {"field": "properties.SA3_NAME21", "type": "nominal", "title": "Region"},
          {"field": "2021-22", "type": "quantitative", "title": "% Change in Median Salary", "format": ".2%"}
        ]
      }
    },
    {
      "data": {
        "url": "https://friedchickenbigdrip.github.io/FIT3179-Week-9-Homework/js/output.json",
        "format": {"type": "topojson", "feature": "ne_110m_graticules_1"}
      },
      "mark": {"type": "geoshape", "fill": null, "stroke": "gray"}
    } 

  ]
}